# Copia questo file in .env.local e inserisci la tua API key Anthropic
# NON condividere mai .env.local — è già in .gitignore per default

ANTHROPIC_API_KEY=sk-ant-...

# Voce del cliente con OpenAI (opzionale: senza, si usa la voce del browser)
OPENAI_API_KEY=sk-...
